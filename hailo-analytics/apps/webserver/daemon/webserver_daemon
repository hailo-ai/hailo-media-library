#!/bin/sh
### BEGIN INIT INFO
# Provides:          webserver_daemon
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Keepalive daemon for camera-viewer-server
# Description:       Launches/stops the Python keepalive script
### END INIT INFO

DAEMON_PATH="/usr/bin"
DAEMON="webserver_daemon.py"
PYTHON="/usr/bin/python3"
NAME="webserver_daemon"

case "$1" in
  start)
    if [ "$2" != "" ]; then
      echo "Starting ${NAME} with args: $2"
      bash -c "cd ${DAEMON_PATH} && nohup ${PYTHON} ${DAEMON} $2 >/dev/null 2>&1 &"
    else
      echo "Starting ${NAME}"
      bash -c "cd ${DAEMON_PATH} && nohup ${PYTHON} ${DAEMON} >/dev/null 2>&1 &"
    fi
    ;;
  stop)
    echo "Stopping ${NAME}..."
    # kill by matching the script name
    killall -f "${PYTHON} ${DAEMON}"
    sleep 2
    ;;
  restart|force-reload)
    $0 stop
    sleep 1
    $0 start $2
    ;;
  status)
    if pgrep -f "${PYTHON} ${DAEMON}" >/dev/null; then
      echo "${NAME} is running."
      exit 0
    else
      echo "${NAME} is not running."
      exit 1
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/${NAME} {start|stop|status|restart} [args]" >&2
    exit 2
    ;;
esac

exit 0
